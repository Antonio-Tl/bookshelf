// Cloudflare Worker "bookshelf": statische Seite plus worker.js für /api/*.
// Der Name muss zum Worker im Dashboard passen, sonst legt `wrangler deploy` einen neuen an.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bookshelf",
  "main": "worker.js",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Nur die API geht durch den Worker; Seiten, Bilder und Skripte liefert Cloudflare direkt aus.
    "run_worker_first": ["/api/*"]
  },
  // /api/books: höchstens 60 Anfragen an Google pro IP und Minute (worker.js). /api/scan, /api/checkout,
  // /api/withdraw und /api/usage zusammen: 20 pro IP und Minute, damit Skripte nicht Supabase, Stripe und
  // Gemini mit Anfragen fluten. namespace_id ist eine frei gewählte Zahl, die im Cloudflare-Konto eindeutig sein muss.
  "ratelimits": [
    { "name": "BOOKS_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "API_LIMITER", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
  ],
  // Öffentliche Werte (stehen auch in js/config.js); /api/scan prüft damit das Login.
  // Geheim und nur per `wrangler secret put` bzw. lokal in .dev.vars: GOOGLE_BOOKS_API_KEY, GEMINI_API_KEY,
  // STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, PAYMENT_DB_SECRET (Supporter-Kauf, siehe worker.js),
  // CF_API_TOKEN (Worker-Aufrufe für die Kostenübersicht, GET /api/usage; Berechtigung "Account Analytics: Read").
  "vars": {
    "SUPABASE_URL": "https://zlbedwktggcdyfvaerop.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_Xr6uYfqtFsOy8pzgU4Tgvw_qpvol_Aj",
    // Cloudflare-Konto für GET /api/usage; die ID ist kein Geheimnis.
    "CF_ACCOUNT_ID": "f66c793c42e2d05b83bd27de0531cbbe"
  }
}
